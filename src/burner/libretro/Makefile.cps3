# Drivers, cpus and devices for cps3 subset
SOURCES_CXX += $(FBNEO_CPU_DIR)/sh2/sh2.cpp \
	$(FBNEO_BURN_DEVICES_DIR)/joyprocess.cpp \
	$(CPS3_DIR)/cps3run.cpp \
	$(CPS3_DIR)/cps3snd.cpp \
	$(CPS3_DIR)/d_cps3.cpp

INCLUDE_DIRS += $(CPS3_DIR)

CFLAGS += -DSUBSET=\"$(SUBSET)\" -DSUPPORT_SPLIT_DRIVER -DBUILD_CPS3
CXXFLAGS += -DSUBSET=\"$(SUBSET)\" -DSUPPORT_SPLIT_DRIVER -DBUILD_CPS3

# SH2 recompiler (from PicoDrive), on hosts it has a code emitter for
ifeq ($(USE_DRC_SH2),)
	ifeq ($(platform), vita)
		USE_DRC_SH2 = 1
	else ifneq (,$(filter osx unix,$(platform)))
		ifneq (,$(filter arm64 aarch64 x86_64 armv7%,$(shell uname -m)))
			USE_DRC_SH2 = 1
		endif
	endif
endif

ifeq ($(USE_DRC_SH2), 1)
	SH2_DRC_DIR := $(SH2_CPU_DIR)/drc
	SOURCES_C += $(SH2_DRC_DIR)/sh2/compiler.c \
		$(SH2_DRC_DIR)/drc/cmn.c
	INCLUDE_DIRS += $(SH2_DRC_DIR)
	CFLAGS += -DDRC_SH2
	CXXFLAGS += -DDRC_SH2
endif

ifeq ($(USE_DRC_SH2)$(platform), 1vita)
# the generated code is ARM, and handler addresses are stored without the
# thumb bit, so everything it calls must be ARM code as well
$(SH2_DRC_DIR)/sh2/compiler.o $(SH2_DRC_DIR)/drc/cmn.o: CFLAGS += -marm
$(SH2_CPU_DIR)/sh2.o: CXXFLAGS += -marm
endif

# log the time spent per frame in the SH2, sound and video
ifeq ($(CPS3_PROFILE), 1)
	CXXFLAGS += -DCPS3_PROFILE
endif

# extra compiler flags, e.g. for experiments
CFLAGS += $(CPS3_CFLAGS)
CXXFLAGS += $(CPS3_CFLAGS)
