# Drivers, cpus and devices for cps3 subset
SOURCES_CXX += $(FBNEO_CPU_DIR)/sh2/sh2.cpp \
	$(FBNEO_BURN_DEVICES_DIR)/joyprocess.cpp \
	$(CPS3_DIR)/cps3run.cpp \
	$(CPS3_DIR)/cps3snd.cpp \
	$(CPS3_DIR)/d_cps3.cpp

INCLUDE_DIRS += $(CPS3_DIR)

CFLAGS += -DSUBSET=\"$(SUBSET)\" -DSUPPORT_SPLIT_DRIVER -DBUILD_CPS3
CXXFLAGS += -DSUBSET=\"$(SUBSET)\" -DSUPPORT_SPLIT_DRIVER -DBUILD_CPS3
